# Template only. Every replace-* value is rejected by the production validator.
# Release 0.13.0 also blocks production startup because OIDC and ClamAV adapters are not implemented.
PLACEMENTOS_ENVIRONMENT=production
PLACEMENTOS_DEBUG=false
PLACEMENTOS_RELEASE_VERSION=0.13.0
PLACEMENTOS_SECRET_KEY=replace-with-secret-manager-reference-or-injected-value

PLACEMENTOS_IDENTITY_MODE=oidc
PLACEMENTOS_OIDC_ISSUER_URL=https://identity.example.edu
PLACEMENTOS_OIDC_CLIENT_ID=replace-with-oidc-client-id
PLACEMENTOS_OIDC_MEMBERSHIP_OWNER=replace-with-identity-owner

PLACEMENTOS_DATABASE_URL=postgresql+psycopg://placementos_app:replace-url-encoded-app-password@postgres:5432/placementos
PLACEMENTOS_MIGRATION_DATABASE_URL=postgresql+psycopg://placementos:replace-url-encoded-admin-password@postgres:5432/placementos
PLACEMENTOS_WORKFLOW_DATABASE_URL=postgresql://placementos_workflow:replace-url-encoded-workflow-password@postgres:5432/placementos?options=-csearch_path%3Dworkflow_checkpoints
PLACEMENTOS_REDIS_URL=redis://:replace-url-encoded-redis-password@redis:6379/0
PLACEMENTOS_CELERY_BROKER_URL=redis://:replace-url-encoded-redis-password@redis:6379/0
PLACEMENTOS_CELERY_RESULT_BACKEND=redis://:replace-url-encoded-redis-password@redis:6379/1

PLACEMENTOS_S3_ENDPOINT_URL=https://objects.example.edu
PLACEMENTOS_S3_ACCESS_KEY_ID=replace-with-object-access-key
PLACEMENTOS_S3_SECRET_ACCESS_KEY=replace-with-object-secret-key
PLACEMENTOS_S3_BUCKET_NAME=replace-with-private-bucket
PLACEMENTOS_S3_REGION=replace-with-approved-region
PLACEMENTOS_S3_SECURE=true
PLACEMENTOS_MALWARE_SCANNER_MODE=clamav

# "disabled" is a valid manual-only production choice when the reviewed policy forbids model use.
PLACEMENTOS_MODEL_INTERPRETER_MODE=disabled
PLACEMENTOS_MODEL_POLICY_REVIEWED=false
PLACEMENTOS_MODEL_PROVIDER_NAME=
PLACEMENTOS_MODEL_ID=
PLACEMENTOS_MODEL_DATA_REGION=
PLACEMENTOS_EXCEPTION_PLANNER_MODE=disabled

PLACEMENTOS_EMAIL_ADAPTER_MODE=disabled
PLACEMENTOS_LIVE_SEND_ENABLED=false
PLACEMENTOS_PRODUCTION_SENDER_VERIFIED=false
PLACEMENTOS_PUBLIC_WEB_URL=https://placement.example.edu
PLACEMENTOS_ALLOWED_ORIGINS=["https://placement.example.edu"]

# Optional. Enabling requires institution-approved Google configuration and secrets.
PLACEMENTOS_GOOGLE_CONNECTORS_ENABLED=false
PLACEMENTOS_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
PLACEMENTOS_GOOGLE_CLIENT_SECRET=replace-with-secret-manager-injected-value
PLACEMENTOS_GOOGLE_REDIRECT_URI=https://placement.example.edu/api/v1/integrations/google/callback
PLACEMENTOS_INTEGRATION_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
PLACEMENTOS_INTEGRATION_WEBHOOK_BASE_URL=https://placement.example.edu

PLACEMENTOS_INSTITUTION_TIMEZONE_CONFIRMED=false
PLACEMENTOS_ACADEMIC_CONFIGURATION_REVIEWED=false
PLACEMENTOS_PERMISSIONS_MATRIX_REVIEWED=false
PLACEMENTOS_RETENTION_POLICY_ID=replace-with-approved-policy-id
PLACEMENTOS_RECORD_RETENTION_DAYS=365
PLACEMENTOS_BACKUP_RETENTION_DAYS=30
PLACEMENTOS_DELETION_OWNER=replace-with-authorized-owner
PLACEMENTOS_DEPLOYMENT_REGION=replace-with-approved-region
PLACEMENTOS_OPERATIONS_OWNER=replace-with-operations-owner
PLACEMENTOS_SECURITY_OWNER=replace-with-security-owner
PLACEMENTOS_BACKUP_OWNER=replace-with-backup-owner
PLACEMENTOS_INCIDENT_CONTACT=replace-with-incident-contact
PLACEMENTOS_BACKUP_ENCRYPTION_KEY_ID=replace-with-kms-key-id
PLACEMENTOS_BACKUP_RESTORE_TESTED=false
