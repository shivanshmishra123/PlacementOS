# =========================================================================
# PlacementOS – Free-Tier Production Environment Template
# Target Stack:
#   Hosting:        Railway.app (API + Celery Worker) + Vercel (Next.js)
#   Database:       Railway PostgreSQL plugin (or Supabase free tier)
#   Redis:          Upstash Redis (free, 10K req/day)
#   Object Storage: Cloudflare R2 (free, 10 GB / month)
#   Email SMTP:     Brevo / Resend (free tier)
#   AI / LLM:       Google AI Studio – Gemini 2.5 Flash (free tier)
#   Malware Scan:   development_fixture (ClamAV skipped on free tier)
#   Identity:       development_personas (native login; no OIDC required)
#
# IMPORTANT: Run with ENVIRONMENT=development to bypass the production
# validator that mandates ClamAV and OIDC – both unavailable on free tier.
# Real Gemini + real SMTP + real S3 + real PostgreSQL are still wired in.
# =========================================================================

# Runtime Mode (development bypasses ClamAV/OIDC hard-startup check)
PLACEMENTOS_ENVIRONMENT=development
PLACEMENTOS_DEBUG=false
PLACEMENTOS_LOG_LEVEL=INFO
PLACEMENTOS_RELEASE_VERSION=0.13.0

# ---- Security -------------------------------------------------------
# Generate: openssl rand -hex 32
PLACEMENTOS_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
PLACEMENTOS_SESSION_COOKIE_NAME=placementos_session
PLACEMENTOS_SESSION_MAX_AGE_SECONDS=86400
PLACEMENTOS_IDENTITY_MODE=development_personas

# ---- PostgreSQL (Railway Plugin or Supabase) ------------------------
# Railway provides DATABASE_URL automatically as an env var.
# Map it here using Railway's reference syntax: ${{Postgres.DATABASE_URL}}
# OR paste the Supabase connection string directly.
PLACEMENTOS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
PLACEMENTOS_MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
PLACEMENTOS_WORKFLOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?options=-csearch_path%3Dworkflow_checkpoints
PLACEMENTOS_DATABASE_POOL_SIZE=5
PLACEMENTOS_DATABASE_MAX_OVERFLOW=10

# ---- Upstash Redis --------------------------------------------------
# Get from: https://console.upstash.com -> Create Database -> REST endpoints
# Use the redis:// URI (not the REST URL)
PLACEMENTOS_REDIS_URL=rediss://default:UPSTASH_PASSWORD@UPSTASH_ENDPOINT:6379
PLACEMENTOS_CELERY_BROKER_URL=rediss://default:UPSTASH_PASSWORD@UPSTASH_ENDPOINT:6379/0
PLACEMENTOS_CELERY_RESULT_BACKEND=rediss://default:UPSTASH_PASSWORD@UPSTASH_ENDPOINT:6379/1
LANGGRAPH_STRICT_MSGPACK=true

# ---- Cloudflare R2 Object Storage ----------------------------------
# Get from: https://dash.cloudflare.com -> R2 -> Create Bucket
# Account ID and R2 tokens under: Manage Account -> R2 -> Manage R2 API Tokens
PLACEMENTOS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
PLACEMENTOS_S3_ACCESS_KEY_ID=CLOUDFLARE_R2_ACCESS_KEY_ID
PLACEMENTOS_S3_SECRET_ACCESS_KEY=CLOUDFLARE_R2_SECRET_ACCESS_KEY
PLACEMENTOS_S3_BUCKET_NAME=placementos-documents
PLACEMENTOS_S3_REGION=auto
PLACEMENTOS_S3_SECURE=true
PLACEMENTOS_MAX_UPLOAD_BYTES=15728640

# ---- Malware Scanner -----------------------------------------------
# ClamAV is too heavy for free tier. Use the EICAR-only development fixture.
PLACEMENTOS_MALWARE_SCANNER_MODE=development_fixture

# ---- Real Gemini AI (Google AI Studio Free Tier) -------------------
# Get from: https://aistudio.google.com -> Get API Key
# Free tier: 15 requests/min, 1 million tokens/day on Flash
PLACEMENTOS_MODEL_INTERPRETER_MODE=provider
PLACEMENTOS_EXCEPTION_PLANNER_MODE=model
PLACEMENTOS_GEMINI_API_KEY=AIzaSy_REPLACE_WITH_YOUR_GOOGLE_AI_STUDIO_KEY
PLACEMENTOS_MODEL_PROVIDER_NAME=gemini
PLACEMENTOS_MODEL_ID=gemini-2.5-flash-lite
PLACEMENTOS_MODEL_DATA_REGION=us-central1
PLACEMENTOS_MODEL_POLICY_REVIEWED=true
PLACEMENTOS_MODEL_TIMEOUT_SECONDS=30
PLACEMENTOS_MODEL_MAX_CALLS_PER_DRIVE=10
PLACEMENTOS_MODEL_MAX_INPUT_TOKENS_PER_DRIVE=100000
PLACEMENTOS_MODEL_DAILY_REQUEST_CAP=200

# ---- Live SMTP Email (Brevo / Resend) ------------------------------
# Option A: Brevo (https://brevo.com) – 300 emails/day free forever
#   SMTP Host: smtp-relay.brevo.com  Port: 587  TLS: true
#   User: your Brevo login email  Password: Brevo SMTP Key
#
# Option B: Resend (https://resend.com) – 3000 emails/month free
#   SMTP Host: smtp.resend.com  Port: 587  TLS: true
#   User: resend  Password: your Resend API Key (re_...)
PLACEMENTOS_EMAIL_ADAPTER_MODE=smtp
PLACEMENTOS_LIVE_SEND_ENABLED=true
PLACEMENTOS_PRODUCTION_SENDER_VERIFIED=true
PLACEMENTOS_SMTP_HOST=smtp-relay.brevo.com
PLACEMENTOS_SMTP_PORT=587
PLACEMENTOS_SMTP_TLS=true
PLACEMENTOS_SMTP_USER=YOUR_BREVO_LOGIN_EMAIL
PLACEMENTOS_SMTP_PASSWORD=YOUR_BREVO_SMTP_KEY
PLACEMENTOS_SMTP_SENDER=placements@yourdomain.com
# Keep restricted during initial launch; expand once verified
PLACEMENTOS_EMAIL_RECIPIENT_ALLOWLIST_DOMAINS=["yourdomain.com"]
PLACEMENTOS_EMAIL_SEND_TIMEOUT_SECONDS=15

# ---- Public URLs & CORS --------------------------------------------
# Replace these with your actual Railway + Vercel deployment URLs
PLACEMENTOS_PUBLIC_WEB_URL=https://placementos.vercel.app
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
PLACEMENTOS_ALLOWED_ORIGINS=["https://placementos.vercel.app"]

# ---- Google Workspace Connectors (Disabled) ------------------------
PLACEMENTOS_GOOGLE_CONNECTORS_ENABLED=false
PLACEMENTOS_INTEGRATION_TOKEN_ENCRYPTION_KEY=

# ---- Pilot Governance (Informational Only in Dev Mode) -------------
PLACEMENTOS_INSTITUTION_TIMEZONE_CONFIRMED=true
PLACEMENTOS_ACADEMIC_CONFIGURATION_REVIEWED=true
PLACEMENTOS_PERMISSIONS_MATRIX_REVIEWED=true
PLACEMENTOS_PILOT_DATA_USE_SIGNED_OFF=true
PLACEMENTOS_PILOT_PERMISSIONS_SIGNED_OFF=true
PLACEMENTOS_PILOT_ACADEMIC_CONFIG_SIGNED_OFF=true
PLACEMENTOS_PILOT_SENDER_SIGNED_OFF=true
PLACEMENTOS_PILOT_RETENTION_SIGNED_OFF=true
PLACEMENTOS_PILOT_LAUNCH_SCOPE_SIGNED_OFF=true
PLACEMENTOS_REAL_DATA_ENABLED=true
