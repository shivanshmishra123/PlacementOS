# PlacementOS Environment Configuration Template
# Copy to .env for local development

# Environment Mode: development | test | production
PLACEMENTOS_ENVIRONMENT=development
PLACEMENTOS_DEBUG=true
PLACEMENTOS_LOG_LEVEL=INFO

# Application Security
# WARNING: Generate a secure random 32-character string for production!
PLACEMENTOS_SECRET_KEY=dev_secret_key_placementos_must_be_at_least_32_chars_long
PLACEMENTOS_SESSION_COOKIE_NAME=placementos_session
PLACEMENTOS_SESSION_MAX_AGE_SECONDS=86400

# PostgreSQL Database
# Note: Host port 55432 is used by default in compose to avoid collision with local 5432
PLACEMENTOS_DATABASE_URL=postgresql+psycopg://placementos_app:placementos_app_dev_password@127.0.0.1:55432/placementos
PLACEMENTOS_MIGRATION_DATABASE_URL=postgresql+psycopg://placementos:placementos_dev_password@127.0.0.1:55432/placementos
PLACEMENTOS_DATABASE_POOL_SIZE=10
PLACEMENTOS_DATABASE_MAX_OVERFLOW=20

# Celery & Redis
PLACEMENTOS_REDIS_URL=redis://127.0.0.1:6379/0
PLACEMENTOS_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
PLACEMENTOS_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Private Object Storage (SeaweedFS locally; S3-compatible API)
PLACEMENTOS_S3_ENDPOINT_URL=http://127.0.0.1:4566
PLACEMENTOS_S3_ACCESS_KEY_ID=dev_access_key
PLACEMENTOS_S3_SECRET_ACCESS_KEY=dev_secret_key
PLACEMENTOS_S3_BUCKET_NAME=placementos-dev
PLACEMENTOS_S3_REGION=us-east-1
PLACEMENTOS_S3_SECURE=false
PLACEMENTOS_MALWARE_SCANNER_MODE=development_fixture
PLACEMENTOS_MODEL_INTERPRETER_MODE=fixture

# Email (Mailpit sink in dev; no live emails sent)
PLACEMENTOS_SMTP_HOST=127.0.0.1
PLACEMENTOS_SMTP_PORT=1025
PLACEMENTOS_SMTP_SENDER=noreply@placementos.local
PLACEMENTOS_SMTP_USER=
PLACEMENTOS_SMTP_PASSWORD=
PLACEMENTOS_SMTP_TLS=false

# Web Client and CORS
NEXT_PUBLIC_API_URL=http://localhost:8000
PLACEMENTOS_ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
