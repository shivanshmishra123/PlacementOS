# PlacementOS Environment Configuration Template
# Copy to .env for local development

# Environment Mode: development | test | production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Application Security
# WARNING: Generate a secure random 32-character string for production!
SECRET_KEY=dev_secret_key_placementos_must_be_at_least_32_chars_long
SESSION_COOKIE_NAME=placementos_session
SESSION_MAX_AGE_SECONDS=86400

# PostgreSQL Database
# Note: Host port 55432 is used by default in compose to avoid collision with local 5432
DATABASE_URL=postgresql+psycopg://placementos:placementos_dev_password@localhost:55432/placementos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Private Object Storage (MinIO / S3-compatible)
S3_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY_ID=dev_access_key
S3_SECRET_ACCESS_KEY=dev_secret_key
S3_BUCKET_NAME=placementos-dev
S3_REGION=us-east-1
S3_SECURE=false

# Email (Mailpit sink in dev; no live emails sent)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SENDER=noreply@placementos.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# Web Client and CORS
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
