# PlacementOS Environment Configuration Template
# Copy to .env for local development

# Environment Mode: development | test | production
PLACEMENTOS_ENVIRONMENT=development
PLACEMENTOS_RELEASE_VERSION=0.10.0
PLACEMENTOS_DEBUG=true
PLACEMENTOS_LOG_LEVEL=INFO

# Application Security
# WARNING: Generate a secure random 32-character string for production!
PLACEMENTOS_SECRET_KEY=dev_secret_key_placementos_must_be_at_least_32_chars_long
PLACEMENTOS_IDENTITY_MODE=development_personas
PLACEMENTOS_OIDC_ISSUER_URL=
PLACEMENTOS_OIDC_CLIENT_ID=
PLACEMENTOS_OIDC_MEMBERSHIP_OWNER=
PLACEMENTOS_SESSION_COOKIE_NAME=placementos_session
PLACEMENTOS_SESSION_MAX_AGE_SECONDS=86400

# PostgreSQL Database
# Note: Host port 55432 is used by default in compose to avoid collision with local 5432
PLACEMENTOS_DATABASE_URL=postgresql+psycopg://placementos_app:placementos_app_dev_password@127.0.0.1:55432/placementos
PLACEMENTOS_MIGRATION_DATABASE_URL=postgresql+psycopg://placementos:placementos_dev_password@127.0.0.1:55432/placementos
PLACEMENTOS_DATABASE_POOL_SIZE=10
PLACEMENTOS_DATABASE_MAX_OVERFLOW=20

# Celery & Redis
PLACEMENTOS_REDIS_URL=redis://127.0.0.1:6379/0
PLACEMENTOS_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
PLACEMENTOS_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
PLACEMENTOS_WORKFLOW_DATABASE_URL=postgresql://placementos_workflow:placementos_workflow_dev_password@127.0.0.1:55432/placementos?options=-csearch_path%3Dworkflow_checkpoints
LANGGRAPH_STRICT_MSGPACK=true

# Private Object Storage (SeaweedFS locally; S3-compatible API)
PLACEMENTOS_S3_ENDPOINT_URL=http://127.0.0.1:4566
PLACEMENTOS_S3_ACCESS_KEY_ID=dev_access_key
PLACEMENTOS_S3_SECRET_ACCESS_KEY=dev_secret_key
PLACEMENTOS_S3_BUCKET_NAME=placementos-dev
PLACEMENTOS_S3_REGION=us-east-1
PLACEMENTOS_S3_SECURE=false
PLACEMENTOS_MALWARE_SCANNER_MODE=development_fixture
PLACEMENTOS_MODEL_INTERPRETER_MODE=fixture
PLACEMENTOS_MODEL_PROVIDER_NAME=
PLACEMENTOS_MODEL_ID=
PLACEMENTOS_MODEL_DATA_REGION=
PLACEMENTOS_MODEL_POLICY_REVIEWED=false
PLACEMENTOS_MODEL_MAX_CALLS_PER_DRIVE=10
PLACEMENTOS_MODEL_MAX_INPUT_TOKENS_PER_DRIVE=100000
PLACEMENTOS_MAX_UPLOAD_BYTES=15728640
PLACEMENTOS_MAX_PDF_PAGES=50
PLACEMENTOS_MAX_EXTRACTED_TEXT_CHARS=2000000

# Email (Mailpit sink in dev; no live emails sent)
PLACEMENTOS_SMTP_HOST=127.0.0.1
PLACEMENTOS_SMTP_PORT=1025
PLACEMENTOS_SMTP_SENDER=noreply@placementos.local
PLACEMENTOS_SMTP_USER=
PLACEMENTOS_SMTP_PASSWORD=
PLACEMENTOS_SMTP_TLS=false
PLACEMENTOS_EMAIL_ADAPTER_MODE=mailpit
PLACEMENTOS_LIVE_SEND_ENABLED=false
PLACEMENTOS_PRODUCTION_SENDER_VERIFIED=false
PLACEMENTOS_EMAIL_RECIPIENT_ALLOWLIST_DOMAINS=["apex.edu", "beacon.edu"]
PLACEMENTOS_EMAIL_SEND_TIMEOUT_SECONDS=10
PLACEMENTOS_PUBLIC_WEB_URL=http://localhost:3000

# Institution-owned real-data pilot gates. Keep unset/false for the synthetic local release.
PLACEMENTOS_INSTITUTION_TIMEZONE_CONFIRMED=false
PLACEMENTOS_ACADEMIC_CONFIGURATION_REVIEWED=false
PLACEMENTOS_PERMISSIONS_MATRIX_REVIEWED=false
PLACEMENTOS_RETENTION_POLICY_ID=
PLACEMENTOS_RECORD_RETENTION_DAYS=
PLACEMENTOS_BACKUP_RETENTION_DAYS=
PLACEMENTOS_DELETION_OWNER=
PLACEMENTOS_DEPLOYMENT_REGION=
PLACEMENTOS_OPERATIONS_OWNER=
PLACEMENTOS_SECURITY_OWNER=
PLACEMENTOS_BACKUP_OWNER=
PLACEMENTOS_INCIDENT_CONTACT=
PLACEMENTOS_BACKUP_ENCRYPTION_KEY_ID=
PLACEMENTOS_BACKUP_RESTORE_TESTED=false

# Web Client and CORS
NEXT_PUBLIC_API_URL=http://localhost:8000
PLACEMENTOS_ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
