  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Application liveness probe",
        "description": "Return basic process liveness.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Application readiness probe",
        "description": "Check connectivity to PostgreSQL database and Redis.",
        "operationId": "get_readiness_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
