          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Import Preview Api V1 Students Import Preview Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students/import-commit": {
      "post": {
        "tags": [
          "Student Records & Corrections"
        ],
        "summary": "Import Commit",
        "description": "Commit verified previewed students into database with immutable revisions.",
        "operationId": "import_commit_api_v1_students_import_commit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CSVCommitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Import Commit Api V1 Students Import Commit Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/student/me": {
      "get": {
        "tags": [
          "Student Records & Corrections"
        ],
        "summary": "Get My Student Profile",
        "description": "Student self-service view returning own verified record and history.",
        "operationId": "get_my_student_profile_api_v1_student_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
