          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students/import-preview": {
      "post": {
        "tags": [
          "Student Records & Corrections"
        ],
        "summary": "Import Preview",
        "description": "Parse and validate student CSV upload without making mutations.",
