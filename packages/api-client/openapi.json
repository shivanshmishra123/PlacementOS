    "/api/v1/students": {
      "get": {
        "tags": [
          "Student Records & Corrections"
        ],
        "summary": "List Students",
        "description": "List student records scoped strictly to coordinator's institution (INV-06).",
        "operationId": "list_students_api_v1_students_get",
        "parameters": [
          {
            "name": "branch",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by academic branch",
              "title": "Branch"
            },
            "description": "Filter by academic branch"
          },
          {
            "name": "min_cgpa",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum CGPA filter",
              "title": "Min Cgpa"
            },
            "description": "Minimum CGPA filter"
          },
          {
            "name": "graduation_year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Graduation cohort filter",
              "title": "Graduation Year"
            },
            "description": "Graduation cohort filter"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StudentListItemDTO"
                  },
                  "title": "Response List Students Api V1 Students Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students/{student_id}": {
      "get": {
        "tags": [
          "Student Records & Corrections"
        ],
        "summary": "Get Student Detail",
        "description": "Get complete student detail with full audit revision history within institution scope.",
        "operationId": "get_student_detail_api_v1_students__student_id__get",
        "parameters": [
          {
            "name": "student_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Student Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
