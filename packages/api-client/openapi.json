                "schema": {
                  "$ref": "#/components/schemas/StudentDetailDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/student/corrections": {
      "get": {
        "tags": [
          "Student Records & Corrections"
        ],
        "summary": "List My Corrections",
        "description": "Student self-service view to track status of their own correction proposals.",
        "operationId": "list_my_corrections_api_v1_student_corrections_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CorrectionProposalDTO"
                  },
                  "type": "array",
                  "title": "Response List My Corrections Api V1 Student Corrections Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Student Records & Corrections"
        ],
        "summary": "Submit Correction Proposal",
        "description": "Student submits a correction proposal for academic facts (P02-T06).",
        "operationId": "submit_correction_proposal_api_v1_student_corrections_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorrectionProposalCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorrectionProposalDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students/corrections/pending": {
      "get": {
        "tags": [
          "Student Records & Corrections"
        ],
        "summary": "List Pending Corrections",
        "description": "Coordinator view of pending correction proposals awaiting decision.",
        "operationId": "list_pending_corrections_api_v1_students_corrections_pending_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CorrectionProposalDTO"
                  },
                  "type": "array",
                  "title": "Response List Pending Corrections Api V1 Students Corrections Pending Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students/corrections/{proposal_id}/decide": {
      "post": {
        "tags": [
          "Student Records & Corrections"
        ],
        "summary": "Decide Correction Proposal",
        "description": "Coordinator accepts or rejects correction proposal with evidence (P02-T06).",
        "operationId": "decide_correction_proposal_api_v1_students_corrections__proposal_id__decide_post",
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Proposal Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorrectionDecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorrectionProposalDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcademicRevisionDTO": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "revision_number": {
            "type": "integer",
            "title": "Revision Number"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Reference"
          },
          "is_verified": {
            "type": "boolean",
            "title": "Is Verified"
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified At"
          },
          "branch": {
            "type": "string",
            "title": "Branch"
          },
          "cgpa": {
            "type": "number",
            "title": "Cgpa"
          },
          "cgpa_scale": {
            "type": "number",
            "title": "Cgpa Scale"
          },
          "graduation_year": {
            "type": "integer",
            "title": "Graduation Year"
          },
          "active_backlogs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Backlogs"
          },
          "history_backlogs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "History Backlogs"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "revision_number",
          "source",
          "is_verified",
          "branch",
          "cgpa",
          "cgpa_scale",
          "graduation_year",
          "created_at"
        ],
        "title": "AcademicRevisionDTO"
      },
      "CSVCommitRequest": {
        "properties": {
          "preview_token": {
            "type": "string",
            "title": "Preview Token"
          }
        },
        "type": "object",
        "required": [
          "preview_token"
        ],
        "title": "CSVCommitRequest"
      },
      "CSVPreviewRequest": {
        "properties": {
          "csv_content": {
            "type": "string",
            "title": "Csv Content"
          }
        },
        "type": "object",
        "required": [
          "csv_content"
        ],
        "title": "CSVPreviewRequest"
      },
      "CorrectionDecisionRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "title": "Decision"
          },
          "review_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Notes"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "CorrectionDecisionRequest"
      },
      "CorrectionProposalCreateRequest": {
        "properties": {
          "proposed_changes": {
            "additionalProperties": true,
            "type": "object",
            "title": "Proposed Changes",
            "description": "Fields to correct e.g. {'cgpa': '8.75', 'active_backlogs': 0}"
          },
          "justification": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Justification"
          },
          "supporting_document_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supporting Document Url"
          }
        },
        "type": "object",
        "required": [
          "proposed_changes",
          "justification"
        ],
        "title": "CorrectionProposalCreateRequest"
      },
      "CorrectionProposalDTO": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "student_profile_id": {
            "type": "string",
            "format": "uuid",
            "title": "Student Profile Id"
          },
          "student_identifier": {
            "type": "string",
            "title": "Student Identifier"
          },
          "student_name": {
            "type": "string",
            "title": "Student Name"
          },
          "proposed_changes": {
            "additionalProperties": true,
            "type": "object",
            "title": "Proposed Changes"
          },
          "justification": {
            "type": "string",
            "title": "Justification"
          },
          "supporting_document_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supporting Document Url"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "review_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Notes"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "student_profile_id",
          "student_identifier",
          "student_name",
          "proposed_changes",
          "justification",
          "status",
          "created_at"
        ],
        "title": "CorrectionProposalDTO"
      },
      "DevLoginRequest": {
        "properties": {
          "persona": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Persona"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "institution_slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution Slug"
          }
        },
        "type": "object",
        "title": "DevLoginRequest"
      },
      "DevLoginResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "user": {
            "$ref": "#/components/schemas/UserProfileResponse"
          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          },
          "session_token": {
            "type": "string",
            "title": "Session Token"
          }
        },
        "type": "object",
        "required": [
          "message",
          "user",
          "csrf_token",
          "session_token"
        ],
        "title": "DevLoginResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ],
            "title": "Status"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "environment",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Liveness probe response payload."
      },
      "PersonaInfo": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "institution_slug": {
